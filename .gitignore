# Rust build output
/target/

# Local toolchains used for Windows builds (not source). Keep the tracked
# scripts in tools/ (release.ps1, links.ps1, hydrate-site.ps1, serve-site.ps1).
/tools/mingw64/
/tools/binutils/
/tools/msvcrt/
/tools/nsis/
/installer/tools/

# Built launcher artifacts: rebuild with `cargo build --release`.
# Publish them through GitHub Releases instead of history.
/dist/
/site/downloads/*.exe
/site/downloads/*.zip
/site/downloads/*.deb
/site/downloads/*.AppImage
/site/downloads/*.dmg
/site/downloads/*.tar.gz

# Scratch renders and captures
/media/tmp/
*.pdb

# Editor/agent workspace metadata
/.freebuff/
